#!/usr/bin/expect -f
set timeout 300
set pw "Xhx19891211"
set mux "-o PreferredAuthentications=password -o PubkeyAuthentication=no"

spawn scp {*}$mux /Users/levi/WorkBuddy/2026-08-07-13-05-24/tmua_missing.json root@8.219.151.140:/root/tmua_missing.json
expect { -re "(?i)password:" { send "$pw\r"; exp_continue } eof {} }

spawn scp {*}$mux /Users/levi/WorkBuddy/2026-08-07-13-05-24/bulu.mjs root@8.219.151.140:/root/shanghai-jinrui-practice/apps/api/scripts/bulu.mjs
expect { -re "(?i)password:" { send "$pw\r"; exp_continue } eof {} }

spawn scp {*}$mux /Users/levi/WorkBuddy/2026-08-07-13-05-24/backup2.mjs root@8.219.151.140:/root/shanghai-jinrui-practice/apps/api/backup2.mjs
expect { -re "(?i)password:" { send "$pw\r"; exp_continue } eof {} }

spawn ssh {*}$mux root@8.219.151.140 "cd /root/shanghai-jinrui-practice/apps/api && node backup2.mjs"
expect { -re "(?i)password:" { send "$pw\r"; exp_continue } eof {} }

spawn ssh {*}$mux root@8.219.151.140 "cd /root/shanghai-jinrui-practice/apps/api && node scripts/bulu.mjs"
expect { -re "(?i)password:" { send "$pw\r"; exp_continue } eof {} }
