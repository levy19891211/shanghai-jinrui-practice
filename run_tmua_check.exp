#!/usr/bin/expect -f
set timeout 180
set pw "Xhx19891211"
set mux "-o ControlMaster=auto -o ControlPath=/tmp/ssh_mux_%r@%h:%p -o ControlPersist=180 -o PreferredAuthentications=password -o PubkeyAuthentication=no"
spawn scp {*}$mux /Users/levi/WorkBuddy/2026-08-07-13-05-24/query_tmua.mjs root@8.219.151.140:/root/shanghai-jinrui-practice/apps/api/query_tmua.mjs
expect {
    -re "(?i)password:" { send "$pw\r"; exp_continue }
    eof {}
}
spawn ssh {*}$mux root@8.219.151.140 "cd /root/shanghai-jinrui-practice/apps/api && node query_tmua.mjs; echo '--- deps ---'; ls -la /root/shanghai-jinrui-practice/apps/api/src/lib/parse-import-file.js /root/shanghai-jinrui-practice/apps/api/src/lib/paper-set.js /root/shanghai-jinrui-practice/apps/api/src/lib/text-normalize.js /root/shanghai-jinrui-practice/apps/api/src/lib/text-clean.js /root/shanghai-jinrui-practice/apps/api/src/lib/knowledge-rules.js 2>&1; echo '--- xlsx on server ---'; ls -la /root/tmua.xlsx 2>&1; ls /root/shanghai-jinrui-practice/node_modules/xlsx >/dev/null 2>&1 && echo 'xlsx module ok' || echo 'xlsx module MISSING'"
expect {
    -re "(?i)password:" { send "$pw\r"; exp_continue }
    eof {}
}
