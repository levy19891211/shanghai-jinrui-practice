#!/usr/bin/expect -f
set timeout 600
set pw "Xhx19891211"
set mux "-o ControlMaster=auto -o ControlPath=/tmp/ssh_mux_%r@%h:%p -o ControlPersist=180 -o PreferredAuthentications=password -o PubkeyAuthentication=no"
set cmd "cd /root/shanghai-jinrui-practice && git pull --ff-only && cd apps/web && npm run build && pm2 restart web"
spawn ssh {*}$mux root@8.219.151.140 $cmd
expect {
    -re "(?i)password:" { send "$pw\r"; exp_continue }
    -re "% " { }
    eof {}
}
