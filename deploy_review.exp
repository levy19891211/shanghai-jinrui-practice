#!/usr/bin/expect -f
set timeout 600
set pw "Xhx19891211"
set mux "-o ControlMaster=auto -o ControlPath=/tmp/ssh_mux_review_%r@%h:%p -o ControlPersist=200 -o PreferredAuthentications=password -o PubkeyAuthentication=no"
set ts [clock format [clock seconds] -format "%Y%m%d-%H%M%S"]
set cmd "set -e; cd /root/shanghai-jinrui-practice && echo '=== backup ===' && cp apps/api/prisma/dev.db /root/backups/dev.db.bak-pre-review-$ts && echo backed_up && echo '=== pull ===' && git pull --ff-only && echo '=== db push ===' && cd apps/api && npx prisma db push --accept-data-loss && echo '=== migrate existing students ===' && node approve_existing_students.mjs && echo '=== build web ===' && cd ../web && npm run build && echo '=== restart ===' && pm2 restart api web && echo ALL_DONE"
spawn ssh {*}$mux root@8.219.151.140 $cmd
expect {
    -re "(?i)password:" { send "$pw\r"; exp_continue }
    "ALL_DONE" { }
    eof {}
}
