#!/usr/bin/expect -f
set timeout 120
spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null root@8.219.151.140
expect {
    -re "password:" { send "Xhx19891211\r"; exp_continue }
    -re "\\$|#" { }
    timeout { puts "TIMEOUT"; exit 1 }
}
expect -re "\\$|$"
send -- {cd /root/shanghai-jinrui-practice; echo "=== api-error.log lines 88-130 ==="; sed -n '88,130p' /root/.pm2/logs/api-error.log}
send "\r"
expect -re "\\$|$"
send "exit\r"
expect eof
