#!/usr/bin/expect -f
set timeout 600
set pw "Xhx19891211"
set mux "-o ControlMaster=auto -o ControlPath=/tmp/ssh_mux_%r@%h:%p -o ControlPersist=180 -o PreferredAuthentications=password -o PubkeyAuthentication=no"

# 1) 上传入库脚本到 apps/api/scripts/
spawn scp {*}$mux /Users/levi/WorkBuddy/2026-08-07-13-05-24/scripts/import_tmua.mjs root@8.219.151.140:/root/shanghai-jinrui-practice/apps/api/scripts/import_tmua.mjs
expect { -re "(?i)password:" { send "$pw\r"; exp_continue } eof {} }

# 2) 上传 Excel 数据源
spawn scp {*}$mux "/Users/levi/Downloads/TMUA_题库_导入格式.xlsx" root@8.219.151.140:/root/tmua_import.xlsx
expect { -re "(?i)password:" { send "$pw\r"; exp_continue } eof {} }

# 3) 上传备份脚本
spawn scp {*}$mux /Users/levi/WorkBuddy/2026-08-07-13-05-24/backup2.mjs root@8.219.151.140:/root/shanghai-jinrui-practice/apps/api/backup2.mjs
expect { -re "(?i)password:" { send "$pw\r"; exp_continue } eof {} }

# 4) 备份数据库(去重/入库前)
spawn ssh {*}$mux root@8.219.151.140 "cd /root/shanghai-jinrui-practice/apps/api && node backup2.mjs"
expect { -re "(?i)password:" { send "$pw\r"; exp_continue } eof {} }

# 5) 执行 TMUA 一次性入库(均分 8 套卷)
spawn ssh {*}$mux root@8.219.151.140 "cd /root/shanghai-jinrui-practice/apps/api && node scripts/import_tmua.mjs /root/tmua_import.xlsx"
expect { -re "(?i)password:" { send "$pw\r"; exp_continue } eof {} }
