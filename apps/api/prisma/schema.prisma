// Prisma schema — 金瑞高中综合管理系统(TMUA/ESAT)
// 开发环境:SQLite(不支持 enum,字段用 String 并注释合法值)
// 生产环境:切换 provider 为 "postgresql" 后可恢复为 enum 类型

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// role 合法值:STUDENT | TEACHER | ADMIN | PARENT
//   PARENT   家长账号(由 学号+姓名 精确匹配学生后自动 VERIFIED;未匹配则 PENDING 待班主任审批)
//   ADMIN   最高权限管理员(可进入「教师管理」模块,新建/管理教师账号及其可见范围权限)
// 学生账号审核状态 status 合法值:PENDING | APPROVED | REJECTED
//   PENDING   待教师审核(注册后默认,不能登录/使用系统)
//   APPROVED  已通过审核(可正常使用)
//   REJECTED  已拒绝(账号已删除,邮箱释放可重新注册)
// subject 合法值:数学 | 物理 | 化学 | 生物(科目,知识学科)
// sourceType 合法值:TMUA | ESAT | NSAA | 其他考试题源(题源/试卷类型,与 subject 区分;可扩展)
// type 合法值:SINGLE_CHOICE | MULTIPLE_CHOICE | NUMERIC
// status 合法值:DRAFT | PENDING_REVIEW | PUBLISHED | REJECTED | ARCHIVED
//   DRAFT         草稿(老师自建,未提交)
//   PENDING_REVIEW 待审核(录入/导入后默认状态,学生不可见)
//   PUBLISHED     已发布(老师审核通过,学生可见)
//   REJECTED      已退回(审核未通过,需修改后重新提交)
//   ARCHIVED      已下架
// mode 合法值:PRACTICE | EXAM

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  name             String
  role             String    @default("STUDENT")
  // 教师子角色(仅 role=TEACHER 时有意义;ADMIN 无需填写):
  //   ACADEMIC  教务老师 | ASSISTANT 助教老师 | SUBJECT 任课教师(默认) | COUNSELOR 升学指导老师
  //   权限仍由 role 决定(TEACHER/ADMIN),teacherRole 仅承载岗位称谓与展示
  teacherRole      String?   @default("SUBJECT")
  status           String    @default("PENDING") // 账号审核状态:PENDING | APPROVED | REJECTED
  reviewNote       String?   // 审核意见(拒绝原因等)
  reviewedBy       String?   // 审核人 id
  reviewedAt       DateTime? // 审核时间
  targetUniversity String?
  // 教师可见范围权限(仅对 role=TEACHER 生效;ADMIN 不受限;空/null=全部可见)
  permSubjects    String? // 学科白名单(JSON 数组,如 ["数学"]);空/null=全部学科
  permSourceTypes String? // 题源白名单(JSON 数组,如 ["TMUA"]);空/null=全部题源
  createdAt        DateTime  @default(now())
  sessions         Session[]
  wrongBook        WrongBook[]
  roguelikeRuns    RoguelikeRun[]
  assignments      AssignmentStudent[]
  languageSessions LanguageSession[]
  languageWrongBook LanguageWrongBook[]
  favorites        FavoriteQuestion[]
  groups           Group[] // 老师创建的学生分组
  groupMemberships GroupStudent[] // 学生所属分组(反向关系)
  reviewRequests   ReviewRequest[] // 学生发起的讲评请求(反向关系)

  // ——— 教务模块反向关系(纯新增字段,不影响现有字段与数据)———
  studentNo            String? @unique // 学号(仅学生账号;家长注册按 姓名+学号 精确匹配)
  gender               String?   // 性别(成绩单用;选填)
  birthDate            DateTime? // 出生日期(成绩单用;选填)
  enrollmentDate       DateTime? // 入学时间(成绩单用;选填)
  headedClasses        Class[]                 @relation("ClassHeadTeacher")
  subjectTeaching      ClassSubjectTeacher[]
  classMemberships     ClassMembership[]
  examsCreated         Exam[]                  @relation("ExamCreator")
  scores               Score[]                 @relation("ScoreStudent")
  scoreUpdates         Score[]                 @relation("ScoreUpdater")
  feedbacksReceived    TeacherFeedback[]       @relation("FeedbackStudent")
  feedbacksGiven       TeacherFeedback[]       @relation("FeedbackTeacher")
  timetableEntries     TimetableEntry[]
  courseSelections     StudentCourseSelection[]
  parentLinksAsParent  ParentLink[]            @relation("ParentLinkParent")
  parentLinksAsStudent ParentLink[]            @relation("ParentLinkStudent")
  gpaScores            GpaScore[]              @relation("GpaScoreStudent")
  gpaScoresRecorded    GpaScore[]              @relation("GpaScoreRecorder")

  // ——— 走班模块反向关系(纯新增字段,不影响现有字段与数据)———
  teachingClassesTaught TeachingClassTeacher[] @relation("TeachingClassTeacher")
  enrollments           Enrollment[]           @relation("EnrollmentStudent")
  enrollmentLogsAsStudent EnrollmentLog[]      @relation("EnrollmentLogStudent")
  enrollmentLogsOperated  EnrollmentLog[]      @relation("EnrollmentLogOperator")
  placementRunsCreated    PlacementRun[]       @relation("PlacementRunCreator")
  placementRunsPublished  PlacementRun[]       @relation("PlacementRunPublisher")
  electiveWishes          ElectiveWish[]       @relation("ElectiveWishStudent")

  // ——— 排课模块反向关系(纯新增字段,不影响现有字段与数据)———
  courseBlocksTaught      CourseBlock[]        @relation("CourseBlockTeacher")
}

model Question {
  id         String        @id @default(cuid())
  subject    String // 科目:数学 | 物理 | 化学 | 生物
  sourceType String? // 题源/试卷类型:TMUA | ESAT | NSAA | 其他(与 subject 区分)
  paper      String?
  topic      String // 主知识点名(兼容统计/过滤);关联库由 topicIds 决定
  topicIds   String? // 知识点 id 列表(JSON 数组),题目可归属多个知识点
  difficulty Int           @default(3)
  type       String        @default("SINGLE_CHOICE")
  stem       String
  options    String
  answer     String
  solution   String?
  source     String?
  status     String        @default("PENDING_REVIEW")
  createdBy  String?
  reviewNote String? // 审核意见(驳回原因等)
  reviewedBy String? // 审核人 id
  reviewedAt DateTime? // 审核时间
  autoFixLog String? // 最近一次「一键修正」的记录(JSON 字符串,含修正项与前后值)
  importedAt DateTime? // 批量导入(Excel/Word/PDF)时间;手动录入的题目为空
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  records    AnswerRecord[]
  wrongBook  WrongBook[]
  favorites  FavoriteQuestion[]
  reviewRequests ReviewRequest[] // 题被发起的讲评请求(反向关系)
}

// 题目收藏(学生端做题时收藏题目供自己查阅)
model FavoriteQuestion {
  id         String   @id @default(cuid())
  studentId  String
  student    User     @relation(fields: [studentId], references: [id])
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([studentId, questionId])
}

// 学生讲评请求(从错题本 / 收藏发起,请求老师讲评某题)
// source 合法值:WRONG_BOOK | FAVORITE
//   WRONG_BOOK 来自错题本
//   FAVORITE   来自题目收藏
// status 合法值:PENDING | RESOLVED
//   PENDING   待讲评(默认)
//   RESOLVED  老师已讲评
model ReviewRequest {
  id         String   @id @default(cuid())
  studentId  String
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  source     String   @default("WRONG_BOOK") // WRONG_BOOK | FAVORITE
  note       String?  // 学生附言(可选)
  status     String   @default("PENDING")    // PENDING | RESOLVED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([studentId, questionId]) // 同生同题仅一条,幂等防重复提交
}

// 知识点(老师手动维护,供题目归类)
// subject 合法值:数学 | 物理 | 化学 | 生物
model KnowledgePoint {
  id        String   @id @default(cuid())
  subject   String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subject, name])
}

// 面试练习题(如剑桥数学面试题):开放式问答,无标准选项
// steps 存 JSON 数组(逐步解答 HTML 片段)
// status 合法值:DRAFT | PUBLISHED | ARCHIVED
model InterviewQuestion {
  id        String   @id @default(cuid())
  subject   String // 标签文字,如 "Number Theory"
  tagClass  String? // 标签配色,如 "nt" | "comb"
  heading   String // 如 "Question 1 · The Sophie Germain identity"
  stem      String // 题干 HTML(含 (i)(ii)(iii) 小问)
  focus     String // "What the interviewer looks for" 提示
  steps     String // JSON 数组,逐步解答 HTML
  sortOrder Int      @default(0)
  status    String   @default("PUBLISHED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 试卷
// origin 合法值:MANUAL(老师手动组卷) | AUTO_SET(套题录入时自动成卷)
// status 合法值:DRAFT | READY | ARCHIVED
//   DRAFT  组卷完成但仍有题目未审核通过 → 学生不可见、不可作答
//   READY  卷内每道题都已审核发布 → 学生可作答
//   ARCHIVED 已下架
// sourceKey:套题去重键(subject::paper::source),保证同一套真题重复导入时并入同一张卷
model Paper {
  id          String   @id @default(cuid())
  title       String
  subject     String // 科目:数学 | 物理 | 化学 | 生物
  sourceType  String? // 题源/试卷类型:TMUA | ESAT | NSAA | 其他(与 subject 区分)
  questionIds String
  source      String? // 来源,如 "TMUA 2016 真题"
  origin      String   @default("MANUAL")
  kind        String   @default("CUSTOM") // 套题类型:OFFICIAL 官方原版套题(如 PDF 导入的 TMUA/ESAT 真题) | CUSTOM 组卷套题(手动组卷或自编导入)
  sourceKey   String?  @unique
  createdBy   String? // 学生自建卷(origin=STUDENT)的创建者;老师组卷/自动成卷为空
  status      String   @default("READY")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  sessions    Session[]
  assignments Assignment[]
}

model Session {
  id           String        @id @default(cuid())
  studentId    String
  student      User          @relation(fields: [studentId], references: [id])
  paperId      String?
  paper        Paper?        @relation(fields: [paperId], references: [id])
  assignmentId String? // 该会话由哪份作业(作业/考试分发)发起;作业类型会话提交后自动回写目标状态
  assignment   Assignment?   @relation(fields: [assignmentId], references: [id])
  mode         String
  durationMin  Int? // EXAM 模式的限时时长(分钟),超时后不可再作答
  deadlineAt   DateTime? // EXAM 模式的绝对截止时间(可变):创建时 = startedAt + durationMin;中途退出暂停后续做时会被改写为 now + 剩余秒,使服务端不会误判超时
  pausedRemaining Int? // EXAM 中途退出暂停时记录的剩余秒数(前端恢复用)
  questionIds  String? // 本次会话全部题目 id(JSON 数组),用于交卷后补齐未答题展示错题
  score        Float?
  total        Int?
  correctCount Int?
  startedAt    DateTime      @default(now())
  submittedAt  DateTime?
  records      AnswerRecord[]
}

model AnswerRecord {
  id         String   @id @default(cuid())
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id])
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  selected   String?
  isCorrect  Boolean?
  timeSpent  Int?
  // 「一题多段」分段停留:JSON 数组 [[startEpochSec, durSec], ...],每题每次进入的起始时刻与该段停留秒数。
  // 由 POST /api/sessions/:id/visits 全量覆盖写入(只写本字段,不触碰 selected/isCorrect/timeSpent)。
  // 2026-09-23 之前的历史记录为 null,前端回退到「answeredAt - timeSpent」合成单段。
  visits     String?
  createdAt  DateTime @default(now())

  @@unique([sessionId, questionId])
}

model WrongBook {
  id         String   @id @default(cuid())
  studentId  String
  student    User     @relation(fields: [studentId], references: [id])
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  wrongCount Int      @default(1)
  mastered   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([studentId, questionId])
}

// Roguelike 冒险模式运行进度(一期:线性爬塔)
// 题目不存于此表——每层临时抽题,答完即弃;判分/连击/血量全部后端权威计算
model RoguelikeRun {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id])
  subject   String
  difficulty Int     @default(3)
  layer     Int      @default(1) // 当前层(从 1 开始)
  hp        Int      @default(5)
  maxHp     Int      @default(5)
  combo     Int      @default(0) // 当前连续正确
  maxCombo  Int      @default(0) // 历史最大连击
  score     Int      @default(0)
  coins     Int      @default(0)
  items     String? // 道具(JSON 数组),一期预留
  status    String   @default("ACTIVE") // ACTIVE | WON | DEAD
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 作业/考试分发(教师端向指定学生布置练习卷/模考卷)
// mode 合法值:PRACTICE | EXAM(决定学生端入口与是否限时)
// status 合法值:ACTIVE | ARCHIVED(教师可下架)
model Assignment {
  id          String    @id @default(cuid())
  teacherId   String // 发布者(教师/管理员)
  paperId     String? // 学科卷(语言作业时为 null)
  paper       Paper?    @relation(fields: [paperId], references: [id])
  languagePaperId String? // 语言卷(雅思等);与 paperId 二选一
  languagePaper   LanguagePaper? @relation(fields: [languagePaperId], references: [id])
  title       String // 作业名称(默认取试卷名)
  note        String? // 备注/要求
  mode        String    @default("PRACTICE")
  durationMin Int? // 模考/考试的限时时长(分钟);由老师分发或考试管理时设置,练习模式可空
  dueAt       DateTime? // DDL(可空 = 不限时提交)
  status      String    @default("ACTIVE")
  groupIds    String? // 按组布置时记录的分组 id(JSON 数组);为空表示逐生布置。用于"分组管理-查看布置"下钻
  createdAt   DateTime  @default(now())
  targets     AssignmentStudent[]
  sessions    Session[]
  languageSessions LanguageSession[]
}

// 作业分发目标:一个学生一份作业一条记录,记录完成状态
// status 合法值:PENDING 未交 | SUBMITTED 已交 | EXPIRED 过期未交(前端按 dueAt 计算,不持久化)
// lateSubmit:逾期补交标记;提交时间晚于 assignment.dueAt 时为 true(仅当 dueAt 非空且作业确实已过期才有意义)
model AssignmentStudent {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  studentId    String
  student      User       @relation(fields: [studentId], references: [id])
  status       String     @default("PENDING")
  lateSubmit   Boolean    @default(false)
  sessionId    String? // 学生点击开始后创建的会话;提交后同步回写
  submittedAt  DateTime?
  createdAt    DateTime   @default(now())

  @@unique([assignmentId, studentId])
}

// ——— 学生分组(教师可将学生分组,作业/考试按组布置)———
// 说明:分组是"教师维度"的便捷选择集合,不替代作业/考试本身的"逐学生"分发结构。
//   作业/考试创建时若传入 groupIds,后端会把组内学生展开成逐生的 AssignmentStudent(向后兼容)。
// Group.name 在同一老师下唯一(teacherId_name),GroupStudent 同组学生唯一(groupId_studentId)。
model Group {
  id        String         @id @default(cuid())
  teacherId String
  teacher   User           @relation(fields: [teacherId], references: [id])
  name      String
  note      String?
  createdAt DateTime       @default(now())
  students  GroupStudent[]

  @@unique([teacherId, name])
}

model GroupStudent {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([groupId, studentId])
}

// ============================================================
// 语言学习模块(雅思/其他语言)——完全独立于学科题库的数据表
// 与 Question/Paper/Session 无任何关联,避免影响现有题库与功能
// ============================================================
// examType 合法值:IELTS | TOEFL | KET_PET | OTHER(其他语言考试,可扩展)
// skill 合法值:LISTENING | READING | WRITING | SPEAKING | FULL(全真连考卷)
// qType 合法值(按 skill 细分):
//   LISTENING: FILL_BLANK 填空 | SINGLE_CHOICE | MULTIPLE_CHOICE | MATCHING 配对
//   READING:   TRUE_FALSE_NG 判断T/F/NG | FILL_BLANK | SINGLE_CHOICE | MATCHING | HEADING 段落标题
//   WRITING:   TASK1 | TASK2(开放作答,教师批改)
//   SPEAKING:  PART1 | PART2 | PART3(录音作答,教师评分)
// status 合法值:DRAFT | PENDING_REVIEW | PUBLISHED | REJECTED | ARCHIVED(与学科题一致)

// 语言题材料:阅读文章 / 写作任务描述 / 口语提示卡(长文本);听力音频直接存 audioUrl
model LanguageMaterial {
  id        String   @id @default(cuid())
  examType  String   @default("IELTS")
  skill     String   @default("READING")
  title     String? // 材料标题,如 "Passage 1: The Return of Artemisia"
  content   String // 材料正文(长文本)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  questions LanguageQuestion[]
}

// 语言题目(独立于学科 Question 表)
model LanguageQuestion {
  id         String   @id @default(cuid())
  examType   String   @default("IELTS")
  skill      String   @default("READING")
  qType      String   @default("SINGLE_CHOICE")
  part       Int? // 听力 Part 1-4 / 阅读 Passage 1-3(全真模考分段用)
  groupTitle String? // 题目组标题(如 "Part 1: 订房电话");无则直接题干
  stem       String // 题干
  options    String? // 选项(JSON 数组,选择题/匹配题)
  answer     String? // 客观题答案;填空支持多个可接受答案用 | 分隔
  solution   String? // 解析(客观题)或参考范文(写作)
  audioUrl   String? // 听力音频地址(教师上传)
  materialId String? // 关联材料(阅读文章/写作任务/口语提示)
  material   LanguageMaterial? @relation(fields: [materialId], references: [id])
  wordLimit  Int? // 写作词数要求
  difficulty Int      @default(3)
  status     String   @default("PENDING_REVIEW")
  reviewNote String?
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  records    LanguageAnswerRecord[]
  wrongBook  LanguageWrongBook[]
}

// 语言试卷(独立于学科 Paper 表)
// mode:PRACTICE 练习 | EXAM 模考(EXAM 时全真卷按 segments 分项倒计时)
// segments:全真连考卷分段配置 JSON,如 [{"skill":"LISTENING","durationMin":30,"questionCount":40},{"skill":"READING","durationMin":60,...},...]
model LanguagePaper {
  id          String   @id @default(cuid())
  examType    String   @default("IELTS")
  skill       String   @default("READING")
  title       String
  questionIds String // 题目 id 列表(JSON 数组)
  segments    String? // 全真连考卷分段配置(JSON 数组,见上注释)
  mode        String   @default("PRACTICE")
  durationMin Int? // EXAM 卷总限时(分钟);练习卷可空
  source      String?
  kind        String   @default("CUSTOM") // OFFICIAL 官方原版 | CUSTOM 组卷
  status      String   @default("READY") // DRAFT | READY | ARCHIVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  sessions    LanguageSession[]
  assignments Assignment[]
}

// 语言会话(独立于学科 Session 表)
// mode:PRACTICE | EXAM
// band:听/读客观题按官方换算表折算;写/口语会话为教师批改后的 Band(可空,未批改)
model LanguageSession {
  id           String   @id @default(cuid())
  studentId    String
  student      User     @relation(fields: [studentId], references: [id])
  paperId      String?
  paper        LanguagePaper? @relation(fields: [paperId], references: [id])
  assignmentId String? // 由语言作业分发发起的会话
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])
  examType     String   @default("IELTS")
  skill        String // 单技能卷的 skill,或 FULL
  mode         String
  durationMin  Int? // EXAM 限时(分钟)
  score        Float? // 客观题原始分
  total        Int?
  correctCount Int?
  band         Float? // 折算后的 Band(0-9,0.5 进制)
  startedAt    DateTime @default(now())
  submittedAt  DateTime?
  records      LanguageAnswerRecord[]
}

// 语言作答记录(独立于学科 AnswerRecord)
// 客观题:selected 存答案,isCorrect 自动判
// 写作/口语:selected 存学生文字作答,audioUrl 存口语录音,band/feedback 由教师批改填写
model LanguageAnswerRecord {
  id         String   @id @default(cuid())
  sessionId  String
  session    LanguageSession @relation(fields: [sessionId], references: [id])
  questionId String
  question   LanguageQuestion @relation(fields: [questionId], references: [id])
  selected   String?
  isCorrect  Boolean?
  band       Float? // 教师批改分项 Band
  feedback   String? // 教师评语
  audioUrl   String? // 口语录音地址
  timeSpent  Int?
  createdAt  DateTime @default(now())

  @@unique([sessionId, questionId])
}

// 语言错题本(独立于学科 WrongBook)
model LanguageWrongBook {
  id         String   @id @default(cuid())
  studentId  String
  student    User     @relation(fields: [studentId], references: [id])
  questionId String
  question   LanguageQuestion @relation(fields: [questionId], references: [id])
  wrongCount Int      @default(1)
  mastered   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([studentId, questionId])
}

// ============================================================
// 升学规划模块(独立:与笔试题库/会话/作业等无任何关联,不影响现有笔试功能与数据)
// 由 public/planning.html(去品牌后的「升学规划档案」)通过 /api/planning 读写
//   data 存档案表单 JSON(字段随前端表单演进,后端不解析其内部结构)
//   plan 存规划方案/知识库(JSON,可选;前端看板也会基于 data 本地计算)
// ============================================================
model PlanningProfile {
  id             String   @id @default(cuid())
  studentId      String   @unique // 以 User(cuid) 为主键,取代原 BLUE 表单的"学生姓名"主键
  data           String // 档案表单完整 JSON(字符串化)
  plan           String? // 规划方案/知识库 JSON(可选)
  parentVisible  Boolean  @default(true) // 家长端是否可见该生升学规划档案(整档开关)
  updatedAt      DateTime @updatedAt
}

// 升学规划「档案填写任务」:教师发布任务 -> 指定学生 -> 学生在学生端填写并提交档案
// 完全独立,与笔试题库/作业/会话等无任何关联。
// status 用字符串常量,避免引入 Prisma enum 与迁移复杂度:
//   PlanningTask.status      : ACTIVE(进行中) | CLOSED(已关闭/重开前)
//   PlanningTaskStudent.status: PENDING(未开始) | DRAFT(已保存草稿) | SUBMITTED(已提交)
model PlanningTask {
  id         String   @id @default(cuid())
  teacherId  String // 发布者(User cuid)
  title      String // 任务标题,默认"完善你的升学规划档案"
  intro      String? // 任务说明(可选)
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PlanningTaskStudent {
  id          String    @id @default(cuid())
  taskId      String
  studentId   String
  status      String    @default("PENDING") // PENDING | DRAFT | SUBMITTED
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([taskId, studentId])
}

// ============================================================
// 教务管理模块(独立:与笔试题库/会话/作业/升学规划等无任何关联,不影响现有功能与数据)
// 设计要点:
//   - 多科多师:一个班一门课可有多个任课教师(ClassSubjectTeacher,role=LEAD|CO|ASSISTANT)
//   - 录分:Exam + Score(每个 exam×student 一条,可空 rankInClass)
//   - 教师反馈:TeacherFeedback(逐条 visibility + DRAFT/PUBLISHED 草稿态)
//   - 家长:ParentLink(学号+姓名精确匹配→VERIFIED;否则 PENDING 待班主任审批)
//   - 课程表:TimetableEntry
// 全部为新增表/可空字段,prisma db push 对现有表零破坏。
// ============================================================

// 班级
// grade 合法值举例:高一 | 高二 | 高三(或留空)
// term 合法值举例:第一学期 | 第二学期 | 全年
model Class {
  id             String   @id @default(cuid())
  name           String // 班级名称,如 "高三(1)班"
  grade          String? // 年级,如 "高三"
  academicYear   String // 学年,如 "2026-2027"
  term           String // 学期,如 "第一学期"
  headTeacherId  String? // 班主任 User id
  headTeacher    User?    @relation("ClassHeadTeacher", fields: [headTeacherId], references: [id])
  createdAt      DateTime @default(now())

  memberships    ClassMembership[]
  subjectTeachers ClassSubjectTeacher[]
  exams          Exam[]
  timetable      TimetableEntry[]
  courses        Course[]
}

// 班级-科目-教师(多科多师:一个班一门课可有多位教师)
// role 合法值:LEAD(主讲) | CO(副讲/协同) | ASSISTANT(助教)
model ClassSubjectTeacher {
  id        String   @id @default(cuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   String // 科目:数学 | 物理 | 化学 | 生物
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id])
  role      String   @default("LEAD") // LEAD | CO | ASSISTANT

  @@unique([classId, subject, teacherId])
}

// 班级成员(学生归属某班)
model ClassMembership {
  id        String   @id @default(cuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([classId, studentId])
}

// 考试/测验
// 归属二选一(双轨共存,互不破坏):
//   - classId         传统按行政班录入(既有数据原样保留)
//   - teachingClassId 走班考核按教学班录入(新流程)
// classId 由必填放宽为可空,仅为支持走班流程,既有行不受影响
// type 合法值:DAILY(日常) | MONTHLY(月考) | MIDTERM(期中) | FINAL(期末) | OTHER(其他)
model Exam {
  id           String   @id @default(cuid())
  classId      String?
  class        Class?   @relation(fields: [classId], references: [id], onDelete: SetNull)
  teachingClassId String?
  teachingClass   TeachingClass? @relation(fields: [teachingClassId], references: [id], onDelete: SetNull)
  subject      String // 科目:数学 | 物理 | 化学 | 生物
  title        String // 考试名称,如 "第一次月考"
  type         String   @default("DAILY") // DAILY | MONTHLY | MIDTERM | FINAL | OTHER
  examDate     DateTime // 考试日期
  totalScore   Float    @default(100) // 满分
  createdBy    String // 创建者(教师/管理员) User id
  creator      User     @relation("ExamCreator", fields: [createdBy], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  scores       Score[]
  feedbacks    TeacherFeedback[]

  @@index([teachingClassId])
}

// 成绩(每个 exam×student 唯一一条;rankInClass 对学生/家长可见)
model Score {
  id          String   @id @default(cuid())
  examId      String
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId   String
  student     User     @relation("ScoreStudent", fields: [studentId], references: [id], onDelete: Cascade)
  score       Float // 得分
  rankInClass Int? // 班级排名(对学生/家长可见)
  comment     String? // 教师评语(可选)
  updatedBy   String? // 最后录入/修改者 User id
  updater     User?    @relation("ScoreUpdater", fields: [updatedBy], references: [id])
  updatedAt   DateTime @updatedAt

  @@unique([examId, studentId])
}

// 教师反馈(逐条可见性 + 草稿态)
// visibility 合法值:STUDENT(仅学生) | PARENT(仅家长) | BOTH(都可见)
// status 合法值:DRAFT(草稿,未发布) | PUBLISHED(已发布)
model TeacherFeedback {
  id         String   @id @default(cuid())
  studentId  String
  student    User     @relation("FeedbackStudent", fields: [studentId], references: [id], onDelete: Cascade)
  teacherId  String
  teacher    User     @relation("FeedbackTeacher", fields: [teacherId], references: [id])
  subject    String? // 关联科目(可选)
  examId     String? // 关联考试(可选)
  exam       Exam?    @relation(fields: [examId], references: [id], onDelete: SetNull)
  content    String // 反馈内容
  visibility String   @default("BOTH") // STUDENT | PARENT | BOTH
  status     String   @default("PUBLISHED") // DRAFT | PUBLISHED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// 课程表条目
// dayOfWeek 合法值:1-7(周一至周日)
model TimetableEntry {
  id            String   @id @default(cuid())
  classId       String
  class         Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  dayOfWeek     Int // 1-7
  period        Int // 第几节(网格导入时为行序,保序)
  periodLabel   String? // 节次名(如"第一节"/"早读/班会",导入网格时提取)
  periodTime    String? // 时间段(如"8:15-8:55",导入网格时提取)
  subject       String // 科目
  teacherId     String? // 教师(可空:课表导入网格格式无教师列)
  teacher       User?    @relation(fields: [teacherId], references: [id])
  room          String? // 教室
  academicYear  String
  term          String
  // 来源课程块(排课管理拖拽产生;手动新增/网格导入的条目为 null)
  // onDelete: SetNull ⇒ 删除课程块不会连带删掉已排课表(subject/teacherId/room 已快照在本条目上)
  courseBlockId String?
  courseBlock   CourseBlock? @relation(fields: [courseBlockId], references: [id], onDelete: SetNull)

  // 唯一键含 teacherId:同一 slot 允许多门课程并存(选课走班 / 分层走班),
  // 只禁止"同一时段 / 同一科目 / 同一教师"的完全重复条目。
  // 典型走班形态:同一格内「英语·王老师(A层)」+「英语·李老师(B层)」,或「A2经济」+「AS生物」+「AS经济」并行。
  @@unique([classId, dayOfWeek, period, subject, teacherId, academicYear, term])
  @@index([courseBlockId])
  @@index([classId, academicYear, term])
}

// 家长-学生关联
// relation 合法值举例:父亲 | 母亲 | 监护人
// status 合法值:PENDING(待审批) | VERIFIED(已验证) | REVOKED(已解除)
// matchMethod 合法值:EXACT(学号+姓名精确匹配自动通过) | MANUAL(班主任手动审批)
model ParentLink {
  id             String   @id @default(cuid())
  parentUserId   String
  parent         User     @relation("ParentLinkParent", fields: [parentUserId], references: [id], onDelete: Cascade)
  studentUserId  String
  student        User     @relation("ParentLinkStudent", fields: [studentUserId], references: [id], onDelete: Cascade)
  relation       String? // 与学生关系,如 父亲 | 母亲 | 监护人
  status         String   @default("PENDING") // PENDING | VERIFIED | REVOKED
  matchMethod    String? // EXACT | MANUAL
  verifiedAt     DateTime?
  createdAt      DateTime @default(now())

  @@unique([parentUserId, studentUserId])
}

// ============================================================
// 学校开设课程目录(课程库) —— 「课程管理」模块维护全校开设的所有课程
// 设计要点:
//   - 与班级解耦:这里是"学校开哪些课"的主数据,不绑定班级/学期;
//     班级维度的科目目录仍是 Course(班级×学年×学期×科目),两者互不影响
//   - 与 GPA 课程体系 GpaCourse(按 学年+年级 配置权重) 职责不同:此处只维护课程本身
//   - 用 active 做软下架(停用)而非直接删除,避免历史引用断裂
//   - 任课教师存姓名文本 teacherName(可录外聘/兼职教师),不建 FK,避免人员变动耦合
// ============================================================

// 学校开设课程
// type 合法值:REQUIRED(必修) | ELECTIVE(选修)
// category 建议值:学术核心 | 素养与综合 | 艺术与体育 | 研究与创新 | 人工智能与实践
model SchoolCourse {
  id          String   @id @default(cuid())
  name        String // 课程名称,如 "A Level 数学"
  subject     String   @default("") // 学科归属,如 "数学" | "物理" | "跨学科"(空=未指定)
  category    String   @default("学术核心") // 课程类别
  type        String   @default("ELECTIVE") // REQUIRED | ELECTIVE
  grade       String   @default("") // 适用年级,如 "高一"(空=全年级通用)
  weeklyHours Float? // 周课时(可空)
  teacherName String   @default("") // 任课教师姓名(文本)
  sortOrder   Int      @default(0) // 展示排序,越小越靠前
  active      Boolean  @default(true) // 是否仍在开设(false=停用/软下架)
  note        String   @default("") // 备注 / 课程简介
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, grade])
  @@index([active, sortOrder])
}

// ============================================================
// 学生选课(选修/必修)
// 设计要点:
//   - 独立课程目录 Course:每个班每学期的科目及其类型(REQUIRED 必修 | ELECTIVE 选修)
//   - 学生选课 StudentCourseSelection:每生每班每学期一条;submittedAt 非空即锁定,后续仅班主任/管理员可改
//   - 课表过滤(buildStudentRecords):某班该学期存在目录且学生已提交 → 仅显示 必修 + 已选选修;否则全显(向后兼容)
// ============================================================

// 课程目录(独立):每个班每学期的科目及其必修/选修类型
// type 合法值:REQUIRED(必修,默认选中不可取消) | ELECTIVE(选修,学生自行勾选)
model Course {
  id           String @id @default(cuid())
  classId      String
  class        Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear String
  term         String
  name         String // 科目名,如 "英语" | "A2物理"
  type         String @default("ELECTIVE") // REQUIRED | ELECTIVE

  @@unique([classId, academicYear, term, name])
}

// 学生选课(每生每班每学期一条;submittedAt 非空=已锁定,后续仅班主任/管理员可改)
model StudentCourseSelection {
  id               String   @id @default(cuid())
  studentId        String
  student          User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId          String
  academicYear     String
  term             String
  selectedCourseIds String // JSON 数组:被勾选的选修科目名
  submittedAt      DateTime? // 非空=已提交锁定

  @@unique([studentId, classId, academicYear, term])
}

// ============================================================
// GPA 管理(过程性考核成绩 + 综合评定 + 成绩单)
// 设计要点:
//   - GpaCourse:按「学年+年级」配置课程体系(课程模块/周课时/评定权重),与班级课程目录 Course 解耦
//     (成绩单按年级课程体系组织,不受班级/学期课程目录增删影响)
//   - GpaScore:过程性考核成绩,学生×课程×学季×考核组件 唯一;
//     综合评定 = 各组件按权重加权(缺失组件按剩余权重归一化),等级按分数段映射 A/B/C/D/E
//   - 学年综合评定 = 各学季综合得分的算术平均
// ============================================================

// GPA 课程(按 学年+年级 配置)
// module 合法值:学术核心 | 素养与综合 | 艺术与体育 | 研究与创新 | 人工智能与实践
model GpaCourse {
  id            String   @id @default(cuid())
  academicYear  String // 学年,如 "2026-2027"
  grade         String // 年级,如 "高一" | "高二" | "高三"
  name          String // 课程名称,如 "A Level数学"
  module        String // 课程模块(见上方合法值)
  weeklyHours   Float? // 周课时数(如 PBL 等无课时可空,成绩单显示 "/")
  weightFinal   Float    @default(50) // 期末权重(%)
  weightMidterm Float    @default(30) // 期中权重(%)
  weightRegular Float    @default(20) // 平时权重(%)
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  scores GpaScore[]

  @@unique([academicYear, grade, name])
}

// 过程性考核成绩(学生×课程×学季×考核组件 唯一)
// season 合法值:夏季学 | 秋季学 | 冬季学 | 春季学
// component 合法值:FINAL(期末) | MIDTERM(期中) | REGULAR(平时)
model GpaScore {
  id         String    @id @default(cuid())
  courseId   String
  course     GpaCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId  String
  student    User      @relation("GpaScoreStudent", fields: [studentId], references: [id], onDelete: Cascade)
  season     String
  component  String
  score      Float
  fullScore  Float     @default(100)
  remark     String?
  recordedBy String
  recorder   User      @relation("GpaScoreRecorder", fields: [recordedBy], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([courseId, studentId, season, component])
}

// ============================================================
// 走班(分层走班 / 选课走班)教务模型
// 设计要点(详见 docs/FLEXIBLE_SCHEDULING_DESIGN.md):
//   - 行政班(Class)只管「人归谁管」;教学班(TeachingClass)管「课怎么上、成绩记在哪」
//   - TimeBlock 让「同科目分层班强制同一时段」成为结构不变量,而非运行时校验
//   - Enrollment 是下游(成绩/课表/报表)唯一依据;分层与选课上游流程分离、下游统一
//   - 已确认:分层不影响分数难度(tier 为纯标签);选课超额由教务手工指定
//   - 本阶段为 P0 纯增量:只加表,Exam.classId 仅放宽可空,与既有行政班流程双轨共存
// ============================================================

// 走班时段块:同科目的分层班共享同一时段(教务只指派一次,各层继承)
// slots 为 JSON 数组:[{ dayOfWeek, period, periodLabel?, periodTime? }]
model TimeBlock {
  id            String   @id @default(cuid())
  grade         String // 年级,如 "高一"
  academicYear  String // 学年,如 "2026-2027"
  term          String // 学期,如 "第一学期"
  name          String // 如 "英语分层时段" | "高三选修时段"
  slots         String // JSON 数组
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  teachingClasses TeachingClass[]
  placementRuns   PlacementRun[]

  @@unique([grade, academicYear, term, name])
  @@index([grade, academicYear, term])
}

// 教学班:真正上课与录成绩的单位
// type 合法值:ADMIN(行政班授课) | LEVEL(分层走班) | ELECTIVE(选课走班)
// tier 为自由标签(A/B/C 或 提高/基础),tierOrder 仅用于排序,不硬编码层级数
model TeachingClass {
  id            String   @id @default(cuid())
  subject       String // 科目
  grade         String // 年级
  academicYear  String
  term          String
  type          String   @default("ADMIN") // ADMIN | LEVEL | ELECTIVE
  tier          String? // 层级标签,仅 LEVEL 有
  tierOrder     Int? // 层级排序
  name          String // 如 "高一英语A班"
  capacity      Int? // 容量(可空=不限)
  room          String? // 教室
  blockId       String? // LEVEL/ELECTIVE 指向共享时段块
  block         TimeBlock? @relation(fields: [blockId], references: [id], onDelete: SetNull)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  teachers      TeachingClassTeacher[]
  enrollments   Enrollment[]
  exams         Exam[]

  @@unique([subject, grade, academicYear, term, tier])
  @@index([grade, academicYear, term])
  @@index([blockId])
}

// 教学班教师(多教师:主讲/副讲/助教,对齐原 ClassSubjectTeacher 的能力)
// role 合法值:LEAD(主讲) | CO(副讲) | ASSISTANT(助教)
model TeachingClassTeacher {
  id              String   @id @default(cuid())
  teachingClassId String
  teachingClass   TeachingClass @relation(fields: [teachingClassId], references: [id], onDelete: Cascade)
  teacherId       String
  teacher         User     @relation("TeachingClassTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  role            String   @default("LEAD") // LEAD | CO | ASSISTANT

  @@unique([teachingClassId, teacherId])
  @@index([teacherId])
}

// 走班分配:学生 × 教学班(下游唯一依据)
// 冗余 subject/grade/academicYear/term 以便 DB 级保证「每科每生至多一个教学班」
// (Prisma 无法跨关系建立唯一约束)
// teachingClassId 可空以支持新生未分 / 休学 / 转出(status=UNASSIGNED)
model Enrollment {
  id              String   @id @default(cuid())
  studentId       String
  student         User     @relation("EnrollmentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  teachingClassId String?
  teachingClass   TeachingClass? @relation(fields: [teachingClassId], references: [id], onDelete: SetNull)
  subject         String
  grade           String
  academicYear    String
  term            String
  status          String   @default("ASSIGNED") // ASSIGNED | UNASSIGNED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([studentId, subject, academicYear, term])
  @@index([teachingClassId])
}

// 调剂审计日志:每次分班调整必留痕(家长质疑时可追溯)
model EnrollmentLog {
  id                  String   @id @default(cuid())
  studentId           String
  student             User     @relation("EnrollmentLogStudent", fields: [studentId], references: [id], onDelete: Cascade)
  fromTeachingClassId String?
  toTeachingClassId   String?
  operatorId          String
  operator            User     @relation("EnrollmentLogOperator", fields: [operatorId], references: [id])
  reason              String // 必填原因
  createdAt           DateTime @default(now())

  @@index([studentId])
}

// 分班方案:教务分班的工作单元
// mode 合法值:LEVEL(分层走班) | ELECTIVE(选课走班)
// status 合法值:DRAFT(草稿) | PUBLISHED(已发布) | REVOKED(已撤回)
// tiers       JSON 数组:[{ key, label, capacity, teacherId, room }]
// draftAssign JSON 对象:{ studentId: tierKey }
model PlacementRun {
  id           String   @id @default(cuid())
  subject      String
  grade        String
  academicYear String
  term         String
  mode         String   @default("LEVEL") // LEVEL | ELECTIVE
  status       String   @default("DRAFT") // DRAFT | PUBLISHED | REVOKED
  // blockId:该科目的走班时段块。同科目所有层级共享同一块,
  // 以此把「分层班强制同一时段」做成结构不变量(教务只选一次,各层继承)
  blockId      String?
  block        TimeBlock? @relation(fields: [blockId], references: [id], onDelete: SetNull)
  tiers        String? // JSON 数组
  draftAssign  String? // JSON 对象
  basisExamId  String? // 依据考试(可空=纯人工 / 外部导入)
  basisNote    String? // 依据说明,如 "2026春期末" | "外部排名导入"
  publishedBy  String?
  publisher    User?    @relation("PlacementRunPublisher", fields: [publishedBy], references: [id])
  publishedAt  DateTime?
  createdBy    String
  creator      User     @relation("PlacementRunCreator", fields: [createdBy], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([subject, grade, academicYear, term])
  @@index([status])
}

// 选课志愿(有序):rank=1 为第一志愿;教务对照容量手工指定超额去向
model ElectiveWish {
  id           String   @id @default(cuid())
  studentId    String
  student      User     @relation("ElectiveWishStudent", fields: [studentId], references: [id], onDelete: Cascade)
  subject      String
  rank         Int      @default(1)
  academicYear String
  term         String
  submittedAt  DateTime?

  @@unique([studentId, subject])
  @@index([academicYear, term])
}

// ============================================================
// 排课管理(组课 + 排课)
// 组课:把「科目 + 任课教师」绑定成一个可拖拽的课程块,并声明预计每周课时数与开设年级。
// 排课:选定班级后,把课程块拖进课表 slot(TimetableEntry.courseBlockId 记录来源,
//       同时把 subject/teacherId/room 快照写入条目 ⇒ 删除课程块不会让已排课表消失)。
// ============================================================

// 课程块:一门课 + 一位任课教师 + 预计每周课时数 + 开设年级
model CourseBlock {
  id           String   @id @default(cuid())
  subject      String // 科目,如 "数学"
  teacherId    String? // 任课教师(可空:暂未定教师)
  teacher      User?    @relation("CourseBlockTeacher", fields: [teacherId], references: [id])
  grade        String // 开设年级,如 "高一"
  academicYear String
  term         String
  weeklyHours  Int      @default(0) // 预计每周课时数(排课进度上限)
  room         String? // 建议教室(拖入 slot 时默认带入)
  note         String? // 备注(如 "合班/分层A层")
  sortOrder    Int      @default(0) // 池内展示顺序
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  entries      TimetableEntry[]

  @@index([grade, academicYear, term])
  @@index([subject])
}
