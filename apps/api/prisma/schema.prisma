// Prisma schema — TMUA/ESAT 刷题系统
// 开发环境:SQLite(不支持 enum,字段用 String 并注释合法值)
// 生产环境:切换 provider 为 "postgresql" 后可恢复为 enum 类型

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// role 合法值:STUDENT | TEACHER | ADMIN
// subject 合法值:TMUA | ESAT
// type 合法值:SINGLE_CHOICE | MULTIPLE_CHOICE | NUMERIC
// status 合法值:DRAFT | PENDING_REVIEW | PUBLISHED | REJECTED | ARCHIVED
//   DRAFT         草稿(老师自建,未提交)
//   PENDING_REVIEW 待审核(录入/导入后默认状态,学生不可见)
//   PUBLISHED     已发布(老师审核通过,学生可见)
//   REJECTED      已退回(审核未通过,需修改后重新提交)
//   ARCHIVED      已下架
// mode 合法值:PRACTICE | EXAM

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  name             String
  role             String    @default("STUDENT")
  targetUniversity String?
  createdAt        DateTime  @default(now())
  sessions         Session[]
  wrongBook        WrongBook[]
}

model Question {
  id         String        @id @default(cuid())
  subject    String
  paper      String?
  topic      String // 主知识点名(兼容统计/过滤);关联库由 topicIds 决定
  topicIds   String? // 知识点 id 列表(JSON 数组),题目可归属多个知识点
  difficulty Int           @default(3)
  type       String        @default("SINGLE_CHOICE")
  stem       String
  options    String
  answer     String
  solution   String?
  source     String?
  status     String        @default("PENDING_REVIEW")
  createdBy  String?
  reviewNote String? // 审核意见(驳回原因等)
  reviewedBy String? // 审核人 id
  reviewedAt DateTime? // 审核时间
  autoFixLog String? // 最近一次「一键修正」的记录(JSON 字符串,含修正项与前后值)
  importedAt DateTime? // 批量导入(Excel/Word/PDF)时间;手动录入的题目为空
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  records    AnswerRecord[]
  wrongBook  WrongBook[]
}

// 知识点(老师手动维护,供题目归类)
// subject 合法值:数学 | 物理 | 化学 | 生物
model KnowledgePoint {
  id        String   @id @default(cuid())
  subject   String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subject, name])
}

// 面试练习题(如剑桥数学面试题):开放式问答,无标准选项
// steps 存 JSON 数组(逐步解答 HTML 片段)
// status 合法值:DRAFT | PUBLISHED | ARCHIVED
model InterviewQuestion {
  id        String   @id @default(cuid())
  subject   String // 标签文字,如 "Number Theory"
  tagClass  String? // 标签配色,如 "nt" | "comb"
  heading   String // 如 "Question 1 · The Sophie Germain identity"
  stem      String // 题干 HTML(含 (i)(ii)(iii) 小问)
  focus     String // "What the interviewer looks for" 提示
  steps     String // JSON 数组,逐步解答 HTML
  sortOrder Int      @default(0)
  status    String   @default("PUBLISHED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 试卷
// origin 合法值:MANUAL(老师手动组卷) | AUTO_SET(套题录入时自动成卷)
// status 合法值:DRAFT | READY | ARCHIVED
//   DRAFT  组卷完成但仍有题目未审核通过 → 学生不可见、不可作答
//   READY  卷内每道题都已审核发布 → 学生可作答
//   ARCHIVED 已下架
// sourceKey:套题去重键(subject::paper::source),保证同一套真题重复导入时并入同一张卷
model Paper {
  id          String   @id @default(cuid())
  title       String
  subject     String
  mode        String   @default("PRACTICE")
  durationMin Int? // EXAM 试卷的限时时长(分钟),练习卷可空
  questionIds String
  source      String? // 来源,如 "TMUA 2016 真题"
  origin      String   @default("MANUAL")
  sourceKey   String?  @unique
  status      String   @default("READY")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  sessions    Session[]
}

model Session {
  id           String        @id @default(cuid())
  studentId    String
  student      User          @relation(fields: [studentId], references: [id])
  paperId      String?
  paper        Paper?        @relation(fields: [paperId], references: [id])
  mode         String
  durationMin  Int? // EXAM 模式的限时时长(分钟),超时后不可再作答
  score        Float?
  total        Int?
  correctCount Int?
  startedAt    DateTime      @default(now())
  submittedAt  DateTime?
  records      AnswerRecord[]
}

model AnswerRecord {
  id         String   @id @default(cuid())
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id])
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  selected   String?
  isCorrect  Boolean?
  timeSpent  Int?
  createdAt  DateTime @default(now())

  @@unique([sessionId, questionId])
}

model WrongBook {
  id         String   @id @default(cuid())
  studentId  String
  student    User     @relation(fields: [studentId], references: [id])
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  wrongCount Int      @default(1)
  mastered   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([studentId, questionId])
}
