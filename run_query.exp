#!/usr/bin/expect -f
set timeout 180
set pw "Xhx19891211"
set mux "-o ControlMaster=auto -o ControlPath=/tmp/ssh_mux_%r@%h:%p -o ControlPersist=180 -o PreferredAuthentications=password -o PubkeyAuthentication=no"
spawn scp {*}$mux /Users/levi/WorkBuddy/2026-08-07-13-05-24/query_smc.mjs root@8.219.151.140:/root/shanghai-jinrui-practice/apps/api/query_smc.mjs
expect {
    -re "(?i)password:" { send "$pw\r"; exp_continue }
    eof {}
}
spawn ssh {*}$mux root@8.219.151.140 "cd /root/shanghai-jinrui-practice/apps/api && node query_smc.mjs"
expect {
    -re "(?i)password:" { send "$pw\r"; exp_continue }
    eof {}
}
