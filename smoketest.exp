#!/usr/bin/expect -f
set timeout 120
spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null root@8.219.151.140
expect {
    -re "password:" { send "Xhx19891211\r"; exp_continue }
    -re "\\\$|#" { }
    timeout { puts "TIMEOUT"; exit 1 }
}
expect -re "\\\$|$"
send -- {cd /root/shanghai-jinrui-practice/apps/api}
send "\r"
expect -re "\\\$|$"
send -- {TOK=$(curl -s -X POST http://localhost:4000/api/auth/login -H 'Content-Type: application/json' -d '{"email":"test.student1@jinrui.com","password":"Test123456"}' | python3 -c 'import sys,json;d=json.load(sys.stdin);print(d.get("data",{}).get("token",""))'); echo "TOK_LEN=${#TOK}"}
send "\r"
expect -re "\\\$|$"
send -- {SID=$(curl -s -X POST http://localhost:4000/api/sessions -H 'Content-Type: application/json' -H "Authorization: Bearer $TOK" -d '{"mode":"EXAM","durationMin":30,"limit":5}' | python3 -c 'import sys,json;d=json.load(sys.stdin);print(d.get("data",{}).get("sessionId",""))'); echo "SID=$SID"}
send "\r"
expect -re "\\\$|$"
send -- {curl -s -X POST http://localhost:4000/api/sessions/$SID/pause -H 'Content-Type: application/json' -H "Authorization: Bearer $TOK" -d '{"remaining":600}'; echo}
send "\r"
expect -re "\\\$|$"
send -- {curl -s http://localhost:4000/api/sessions/$SID -H "Authorization: Bearer $TOK"}
send "\r"
expect -re "\\\$|$"
send "exit\r"
expect eof
