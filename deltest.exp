#!/usr/bin/expect -f
set timeout 120
spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null root@8.219.151.140
expect {
    -re "password:" { send "Xhx19891211\r"; exp_continue }
    -re "\\$|#" { }
    timeout { puts "TIMEOUT"; exit 1 }
}
expect -re "\\$|$"
send -- {echo  | base64 -d > /tmp/deltest.mjs && cd /root/shanghai-jinrui-practice/apps/api && node /tmp/deltest.mjs}
send "\r"
expect -re "\\$|$"
send "exit\r"
expect eof
