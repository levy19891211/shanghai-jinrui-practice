#!/usr/bin/expect -f
set timeout 120
spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null root@8.219.151.140
expect {
    -re "password:" { send "Xhx19891211\r"; exp_continue }
    -re "\\\$|#" { }
    timeout { puts "TIMEOUT"; exit 1 }
}
expect -re "\\\$|$"
send "echo '=== api pause/pausedRemaining ===' && grep -c 'pausedRemaining' apps/api/src/routes/sessions.js && grep -c 'pause' apps/api/src/routes/sessions.js\r"
