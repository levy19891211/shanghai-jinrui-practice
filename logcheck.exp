send -- {cd /root/shanghai-jinrui-practice/apps/api; echo "=== recent api errors (500/delete) ==="; pm2 logs api --lines 80 --nostream 2>/dev/null | grep -iE "delete|500|error|assignmentStudent|DELETE" | tail -30}
